@model IEnumerable<RaceDayMVC.Models.EventViewModel>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-3">
    <h2 class="text-primary fw-bold">My Events Dashboard</h2>
    <a asp-action="CreateEvent" class="btn btn-success btn-lg shadow-sm">
        + Create New Event
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center mt-5 p-5 bg-light rounded shadow-sm">
        <h4 class="text-muted">You haven't created any events yet.</h4>
        <p>Click the button above to host your first RaceDay event!</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100 border-0">
                    @if (!string.IsNullOrEmpty(item.BannerImageUrl))
                    {
                        <img src="@item.BannerImageUrl" class="card-img-top" alt="@item.EventName" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                            <span>No Image Uploaded</span>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">@item.EventName</h5>
                        <p class="card-text text-muted mb-1">
                            📅 @item.EventDate.ToString("dd MMM yyyy")
                        </p>
                        <p class="card-text text-muted mb-2">
                            📍 @item.Location
                        </p>
                        <span class="badge bg-primary">@item.Distance km</span>
                        <span class="badge bg-info text-dark text-uppercase">@item.EventType</span>
                    </div>
                    <div class="card-footer bg-white border-0 pt-0">
                        <hr />
                        <div class="d-grid gap-2">
                            <a asp-action="ManageCategories" asp-route-eventId="@item.EventId" class="btn btn-outline-primary btn-sm">
                                Manage Categories
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}