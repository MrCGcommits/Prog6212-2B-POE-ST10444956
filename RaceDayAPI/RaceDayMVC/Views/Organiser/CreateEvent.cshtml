@{
    ViewData["Title"] = "Create Event";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white">
                <h3 class="mb-0">Create a New Event</h3>
            </div>
            <div class="card-body p-4">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                
                <!-- ENCTYPE IS CRITICAL FOR FILE UPLOADS -->
                <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Event Name</label>
                        <input type="text" name="eventName" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="description" class="form-control" rows="3" required></textarea>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Date</label>
                            <input type="date" name="eventDate" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Location</label>
                            <input type="text" name="location" class="form-control" required />
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Distance (km)</label>
                            <input type="number" step="0.1" name="distance" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Event Type</label>
                            <select name="eventType" class="form-select" required>
                                <option value="Run">Run</option>
                                <option value="Walk">Walk</option>
                                <option value="Cycle">Cycle</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Banner Image</label>
                            <!-- This sends the file to the API -> Azure Blob -->
                            <input type="file" name="bannerImage" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100">Create Event</button>
                </form>
            </div>
        </div>
    </div>
</div>