@model IEnumerable<System.Text.Json.JsonElement>
@{
    ViewData["Title"] = "My Enrolments";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<h2 class="mb-4 text-primary fw-bold">My Enrolments</h2>

<table class="table table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Category</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var eventName = item.GetProperty("event").GetProperty("eventName").GetString();
            var eventDate = item.GetProperty("event").GetProperty("eventDate").GetDateTime().ToShortDateString();
            var categoryName = item.GetProperty("category").GetProperty("categoryName").GetString();
            
            <tr>
                <td class="fw-bold">@eventName</td>
                <td>@eventDate</td>
                <td>@categoryName</td>
                <td><span class="badge bg-success">Confirmed</span></td>
            </tr>
        }
    </tbody>
</table>