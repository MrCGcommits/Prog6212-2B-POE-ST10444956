@model RaceDayMVC.Models.EventViewModel
@{
    ViewData["Title"] = Model.EventName;
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow mb-4 border-0">
    @if (!string.IsNullOrEmpty(Model.BannerImageUrl))
    {
        <img src="@Model.BannerImageUrl" class="card-img-top" style="max-height: 400px; object-fit: cover;">
    }
    <div class="card-body p-4">
        <h1 class="display-5 fw-bold text-primary">@Model.EventName</h1>
        <p class="lead mt-3">@Model.Description</p>
        
        <div class="row mt-4">
            <div class="col-md-6">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><strong>Date:</strong> @Model.EventDate.ToLongDateString()</li>
                    <li class="list-group-item"><strong>Location:</strong> @Model.Location</li>
                    <li class="list-group-item"><strong>Distance:</strong> @Model.Distance km</li>
                    <li class="list-group-item"><strong>Type:</strong> @Model.EventType</li>
                </ul>
            </div>
            <div class="col-md-6">
                <h4 class="fw-bold">Available Categories</h4>
                <ul class="list-group shadow-sm">
                    @foreach (var cat in Model.Categories)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @cat.CategoryName
                            <span class="badge bg-secondary rounded-pill">Max: @cat.MaxParticipants</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@if (User.Identity.IsAuthenticated && User.IsInRole("Participant"))
{
    <div class="card shadow-sm border-primary mb-5">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Enrol in this Event</h4>
        </div>
        <div class="card-body">
            <form asp-action="Enroll" method="post">
                <input type="hidden" name="eventId" value="@Model.EventId" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Select Category:</label>
                    <select name="categoryId" class="form-select" required>
                        <option value="">-- Select a Category --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryId">@cat.CategoryName</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-success btn-lg w-100">Confirm Enrolment</button>
            </form>
        </div>
    </div>
}
else if (!User.Identity.IsAuthenticated)
{
    <div class="alert alert-warning text-center mb-5">
        Please <a asp-controller="Account" asp-action="Login" class="fw-bold">Login</a> as a Participant to enrol.
    </div>
}